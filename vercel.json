{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build:vercel",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.mangcaubaden.vn"
        }
      ],
      "destination": "https://mangcaubaden.vn/:path*",
      "permanent": true
    }
  ]
}
